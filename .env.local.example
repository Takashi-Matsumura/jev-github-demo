# TypeSafe AI (Jev / System One) の API キー。https://console.typesafe.ai/
TYPESAFE_API_KEY=

# GitHub Personal Access Token。public repo の読み取りのみで足ります。
# 未設定でも動きますが REST 経由・60 req/h に制限され、取得件数が最新15件までに絞られます。
# 手元の `gh auth token` の値をそのまま使う場合は、シェルで
#   gh auth token
# を実行し、出力を GITHUB_TOKEN= の後ろに貼り付けてください（このファイルには書き込みません）。
GITHUB_TOKEN=

# 1 に設定すると Jev 分類を一切呼ばず、ルール分類のみで動作します（開発用の安全弁）。
JEV_DISABLED=

# 「成長への助言」の文章化に使う、手元の llama.cpp サーバー（OpenAI 互換 API）。
# 外部送信ではなく、既定値のまま 127.0.0.1 で完結します。省略時のデフォルト:
#   GEMMA_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
#   GEMMA_MODEL=gemma-4-12b-it-Q4_K_M.gguf
# llama-server の起動例:
#   llama-server -m <path-to>/gemma-4-12b-it-Q4_K_M.gguf --host 127.0.0.1 --port 8080 \
#     -ngl 999 -c 32768 --parallel 2 --flash-attn on
GEMMA_ENDPOINT=
GEMMA_MODEL=

# 1 に設定すると Gemma 呼び出しを一切行いません（開発用の安全弁）。
GEMMA_DISABLED=
